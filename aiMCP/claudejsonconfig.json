{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C://Users/......//files_claude"
      ]
    },
    "excel-mcp-server": {
      "command": "npx",
      "args": [
        "-y",
        "@negokaz/excel-mcp-server"
      ]
    },
    "rest-api": {
      "command": "npx",
      "args": [
        "-y",
        "dkmaker-mcp-rest-api"
      ],
      "env": {
        "REST_BASE_URL": "https://rahulshettyacademy.com",
        "HEADER_Accept": "application/json"
      }
    },
    "mysql": {
      "command": "C:\\Users\\....Python313\\Scripts\\uv.exe",
      "args": [
        "--directory",
        "C:\\Users\\.....\\Python313\\Lib\\site-packages",
        "run",
        "mysql_mcp_server"
      ],
      "env": {
        "MYSQL_HOST": "localhost",
        "MYSQL_PORT": "1234",
        "MYSQL_USER": "root",
        "MYSQL_PASSWORD": "YourSQLpassword",
        "MYSQL_DATABASE": "rahulshettyacademy"
      }
    }
  },
 } 